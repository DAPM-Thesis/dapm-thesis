{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.dapm.org/pipeline_draft_schema.json",
  "title": "Pipeline Draft",
  "type": "object",
  "properties": {
    "faultToleranceLevel": {
      "description": "Defines the fault tolerance strategy for the entire pipeline. If omitted, a default behavior (e.g., LEVEL_0_IGNORE_FAULTS) is assumed by the application.",
      "type": "string",
      "enum": [
        "LEVEL_NOTIFY_ONLY",
        "LEVEL_TERMINATE_ENTIRE_PIPELINE",
        "LEVEL_KEEP_RUNNING_PARTIAL_PIPELINE",
        "LEVEL_RESTART_FAILED_INSTANCE"
      ]
    },
    "heartbeatTimingConfig": {
      "type": "object",
      "description": "Configuration for heartbeat timing. If only timeoutMs is provided, other values are derived.",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "description": "Primary setting (ms). Max duration to wait for a peer before considering it failed. Minimum 10000.",
          "minimum": 10000
        },
        "sendIntervalMs": {
          "type": "integer",
          "description": "Optional override (ms). How often each PE sends a heartbeat.",
          "minimum": 3000
        },
        "checkIntervalMs": {
          "type": "integer",
          "description": "Optional override (ms). How often each PE checks peer liveness.",
          "minimum": 5000
        },
        "missesThreshold": {
          "type": "integer",
          "description": "Optional override. How many consecutive misses before declaring a peer dead.",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "processing elements": {
      "type": "array",
      "items": {
        "$ref": "https://www.dapm.org/processing_element_reference_schema.json"
      },
      "minItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "inputs": { "type": "array", "maxItems": 0 } }
          },
          "required": ["inputs"]
        },
        {
          "contains": {
            "type": "object",
            "properties": { "output": { "type": "null" } }
          },
          "required": ["output"]
        }
      ]
    },
    "channels": {
      "type": "array",
      "items": { "$ref": "https://www.dapm.org/channel_reference_schema.json" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": ["processing elements", "channels"],
  "additionalProperties": false
}
